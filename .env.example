# ===========================================
# MikkyStream Environment Configuration
# ===========================================

# TMDB API Key (Required)
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API Key (Optional - for accurate IMDB ratings)
# Get your free API key at: https://www.omdbapi.com/apikey.aspx
# Provides: IMDB rating, Metascore, Rotten Tomatoes
OMDB_API_KEY=your_omdb_api_key_here

# Session Secret for JWT authentication (Required)
# Generate a secure random string for production
# Example: openssl rand -base64 32
# WARNING: Never commit your actual secret to git!
SESSION_SECRET=your_session_secret_here

# Site URL (Optional)
# Used for metadata and OpenGraph images
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Database Path (Optional)
# Defaults to ./data/mikkystream.db
# DATABASE_PATH=/var/www/mikkystream/data/mikkystream.db

# Cookie Settings for Production (Optional)
# Set to true when using HTTPS
# FORCE_SECURE_COOKIES=true

# Sentry Configuration (Optional - for error tracking)
# Get your DSN at: https://sentry.io/settings/projects/
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
